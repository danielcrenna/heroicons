<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet Package Metadata -->
    <PackageId>heroicons</PackageId>
    <Version>1.0.1</Version>
    <PackageReleaseNotes>Upgraded to .NET 10</PackageReleaseNotes>
    <Authors>Daniel Crenna</Authors>
    <Description>Blazor component wrapper for Heroicons - the hand-crafted SVG icons by Tailwind Labs. This unofficial port provides easy-to-use Blazor components for all Heroicons.</Description>
    <PackageTags>heroicons;blazor;icons;svg;tailwindcss;components</PackageTags>
    <PackageProjectUrl>https://github.com/danielcrenna/heroicons</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/danielcrenna/heroicons</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

</Project>
